{
  "expo": {
    "name": "Em Dia",
    "slug": "emdia",
    "scheme": "emdia",
    "version": "2.0.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05070D",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070D"
    },
    "ios": {
      "bundleIdentifier": "app.zioncodes.emdia",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Permita o uso do Face ID para bloquear e desbloquear seus dados financeiros com segurança.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.zioncodes.emdia",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05070D"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-local-authentication",
      "expo-sharing"
    ]
  }
}
