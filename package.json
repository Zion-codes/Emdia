{
  "name": "emdia",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --coverage",
    "eas:build:dev": "npx eas-cli build --profile development --platform all",
    "eas:build:preview": "npx eas-cli build --profile preview --platform all",
    "eas:build:prod": "npx eas-cli build --profile production --platform all",
    "eas:build:prod:android": "npx eas-cli build --profile production --platform android",
    "eas:build:prod:ios": "npx eas-cli build --profile production --platform ios",
    "eas:submit:android": "npx eas-cli submit --profile production --platform android",
    "eas:submit:ios": "npx eas-cli submit --profile production --platform ios"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-local-authentication": "~57.0.3",
    "expo-sharing": "~57.0.27",
    "expo-sqlite": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30",
    "jest-expo": "~57.0.0",
    "prettier": "^3.9.10",
    "test-renderer": "^1",
    "typescript": "~6.0.3"
  },
  "private": true
}
